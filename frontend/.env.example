# Copy this file to frontend/.env to change where the frontend looks for the API.
#
# VITE_API_URL: base address of the Mercao API.
# - Not set (default): http://localhost:8000 in npm run dev; relative URLs (/api) in the production build, which is
#   served by the API itself at http://localhost:8000.
# - Empty (VITE_API_URL=): relative URLs (/api) always, forwarded to http://localhost:8000 by the Vite dev and
#   preview servers.
# - Any other address: that API, which must allow the frontend origin in MERCAO_CORS_ORIGINS.
# VITE_API_URL=http://localhost:8000
